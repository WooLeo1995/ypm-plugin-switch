{
  "id": "switch",
  "name": "音源网关",
  "version": "0.1.0",
  "description": "免登录的网易云曲库与多音源网关。内置 GDStudio 与酷我音源，播放前逐个校验直链并自动切换。",
  "author": "ypm-plugin-switch",
  "icon": "icon.png",
  "minAppVersion": "3.0.0",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "interfacepc.music.163.com",
      "music-api.gdstudio.xyz",
      "*.music.126.net",
      "search.kuwo.cn",
      "bd-api.kuwo.cn",
      "mobi.kuwo.cn",
      "*.kuwo.cn"
    ]
  },
  "settings": [
    {
      "key": "quality",
      "label": "音质",
      "type": "select",
      "default": "",
      "help": "优先使用所选音质，不可用时自动降低",
      "options": [
        {
          "value": "",
          "label": "跟随播放器"
        },
        {
          "value": "standard",
          "label": "标准 (128k)"
        },
        {
          "value": "high",
          "label": "高音质 (320k)"
        },
        {
          "value": "lossless",
          "label": "无损 (FLAC，可用时)"
        }
      ]
    },
    {
      "key": "prefer",
      "label": "优先音源",
      "type": "select",
      "default": "auto",
      "help": "网关按此顺序尝试音源，失败的会被自动跳过",
      "options": [
        {
          "value": "auto",
          "label": "自动"
        },
        {
          "value": "gdstudio",
          "label": "GDStudio 优先"
        },
        {
          "value": "kuwo",
          "label": "酷我优先"
        }
      ]
    },
    {
      "key": "skipVerify",
      "label": "跳过播放前校验",
      "type": "boolean",
      "help": "默认会先探测直链是否真的可播；打开后直接采信音源返回值，可能遇到失效链接"
    },
    {
      "key": "disableGdstudio",
      "label": "停用 GDStudio 音源",
      "type": "boolean",
      "help": "停用后只使用酷我音源"
    },
    {
      "key": "disableKuwo",
      "label": "停用酷我音源",
      "type": "boolean",
      "help": "停用后只使用 GDStudio 音源"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "音源网关",
      "page": "sources"
    }
  ]
}
